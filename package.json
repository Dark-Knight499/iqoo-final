{
  "name": "creator-ai-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:all": "python run_all.py",
    "start:all": "python run_all.py",
    "media:server": "node server/index.mjs",
    "mpt:setup": "cd MoneyPrinterTurbo && uv sync --python 3.11",
    "mpt:server": "cd MoneyPrinterTurbo && uv run python main.py",
    "test:media": "node server/engine.test.mjs",
    "analysis:server": "npm --prefix legacy/static-analysis run server:dev",
    "test:analysis": "npm --prefix legacy/static-analysis test",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "node --test src/shared/services/projectOperations.test.mjs src/features/creator-intelligence/tests/*.test.mjs server/*.test.mjs",
    "backend:intel": "python backend/intelligence/run.py",
    "backend:studio": "python backend/run_backend.py"
  },
  "dependencies": {
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
